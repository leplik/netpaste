{
  "name": "netpaste",
  "version": "2.0.0",
  "description": "Encrypted clipboard sync between your machines on a local network",
  "type": "module",
  "bin": {
    "netpaste": "./bin/netpaste.js"
  },
  "files": [
    "bin",
    "src",
    "contrib",
    "docs"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node bin/netpaste.js",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leplik/netpaste.git"
  },
  "keywords": [
    "clipboard",
    "sync",
    "lan",
    "cli",
    "encryption"
  ],
  "author": "Aliaksei Smirnou",
  "license": "MIT",
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "clipboardy": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
